<div class="trainingarchitecture-collapsible">
    <span class="trainingarchitecture-show-hide-table-title">{{collapsetext}}</span>
    <input 
        type="text" 
        class="trainingarchitecture-search-input" 
        id="search-input-level" 
        data-table-id="{{tableid}}" 
        placeholder="{{searchtext}}"
    >

    <div id="{{tableid}}" class="table-container-training-architecture">
        <table class="generaltable">
            <thead>
                <tr>
                    <th>{{fullname_label}}</th>
                    <th>{{shortname_label}}</th>
                    <th>{{actions_label}}</th>
                </tr>
            </thead>
            <tbody>
                {{#levels}}
                    <tr>
                        <td>{{fullname}}</td>
                        <td>{{shortname}}</td>
                        <td>
                            <a href="{{edit_url}}">{{#pix}}t/edit, core{{/pix}}</a>
                            <a href="{{delete_url}}">{{#pix}}t/delete, core{{/pix}}</a>
                        </td>
                    </tr>
                {{/levels}}

                {{^levels}}
                    <tr>
                        <td colspan="3">{{#str}}nodata, local_training_architecture{{/str}}</td>
                    </tr>
                {{/levels}}
            </tbody>
        </table>
    </div>
</div>